# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage/

# next.js
/.next/
/out/

# production
/build
/dist
.cache/
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
Thumbs.db

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) — NEVER commit real secrets
.env
.env.*
!.env.example

# local runtime — NEVER commit production DB / user data / certs / uploads
/data/
/storage/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# private keys / certs (self-signed generated in data/certs)
/data/certs/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# credentials
credentials.json
service-account.json
firebase-adminsdk*.json

# deployment
.vercel
.firebase/
.netlify/

# python (if any scripts)
__pycache__/
*.py[cod]
.venv/
venv/
.env.venv

# IDE
.vscode/
.idea/
